#!/bin/bash
# phone-stt — 맥의 오디오 파일을 갤럭시(폴드8)의 삼성 온디바이스 STT 로 전사한다.
#
# 왜 이런 방식인가:
#   표준 SpeechRecognizer 의 EXTRA_AUDIO_SOURCE(파일 입력)는 이 기기에서 거부된다
#   (인식기 4종 전부 ERROR_CLIENT). 삼성 음성녹음 앱만이 파일 전사를 할 수 있고,
#   외부 인텐트도 없다. 그래서 adb 로 앱 UI 를 몰아 버튼을 누른다.
#
# 사용법: phone-stt <오디오파일> [--keep] [--device <ip:port>] [--out <디렉터리>] [--no-fetch]
#
# 설정: ~/.config/galaxy-ondevice-stt/config.env (config.example.env 참고)
#   PHONE_ADB         adb 기기 ID(ip:port). 비우면 mDNS·게이트웨이·Tailscale 순으로 자동 탐색
#   ADB               adb 경로. 비우면 PATH → Android SDK 기본 위치
#   STT_INBOX         공유된 전사 파일이 맥에 떨어지는 폴더 (예: ClipBridge 수신 폴더)
#   STT_SHARE_TARGET  공유 시트에서 누를 대상 라벨 (기본 「맥으로 보내기」 = ClipBridge)
#   STT_FETCH         clipbridge | none. 기본: STT_INBOX 가 있으면 clipbridge, 없으면 none
#   STT_LANG          언어 선택 다이얼로그에서 고를 언어 (기본 한국어)
#   STT_SIDEBAR_TAP   사이드바 「음성 녹음」 탭 좌표 (기본 "120 508", 폴드8 펼친 화면 기준)
#   STT_DETAIL_MIN_X  2패널에서 오른쪽(상세) 패널로 볼 x 하한 (기본 1150)
set -euo pipefail

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
HERE="$(dirname "$SELF")"
# shellcheck source=lib-config.sh
. "$HERE/lib-config.sh"
load_config
# shellcheck source=lib-device.sh
. "$HERE/lib-device.sh"

DEV="${PHONE_ADB:-}"
REC_DIR="/sdcard/Recordings/Voice Recorder"
INBOX="${STT_INBOX:-}"
SHARE_TARGET="${STT_SHARE_TARGET:-맥으로 보내기}"
FETCH="${STT_FETCH:-}"
SIDEBAR_TAP="${STT_SIDEBAR_TAP:-120 508}"
DETAIL_MIN_X="${STT_DETAIL_MIN_X:-1150}"
PKG="com.sec.android.app.voicenote"
KEEP=0
SRC=""
OUTDIR=""   # 비우면 원본 옆에 저장. Syncthing Receive Only 폴더에는 쓰지 말 것

while [ $# -gt 0 ]; do
  case "$1" in
    --keep) KEEP=1; shift ;;
    --device) DEV="$2"; shift 2 ;;
    --out) OUTDIR="$2"; shift 2 ;;
    --no-fetch) FETCH="none"; shift ;;
    -h|--help) sed -n '2,20p' "$SELF"; exit 0 ;;
    *) SRC="$1"; shift ;;
  esac
done
[ -z "$SRC" ] && { echo "사용법: phone-stt <오디오파일> [--keep] [--device ip:port] [--out 디렉터리] [--no-fetch]"; exit 1; }
[ -f "$SRC" ] || { echo "❌ 파일 없음: $SRC"; exit 1; }

if [ -z "$FETCH" ]; then
  if [ -n "$INBOX" ]; then FETCH="clipbridge"; else FETCH="none"; fi
fi
if [ "$FETCH" = "clipbridge" ] && [ -z "$INBOX" ]; then
  echo "❌ STT_FETCH=clipbridge 인데 STT_INBOX 가 비어 있습니다 (설정 파일 확인)"; exit 1
fi

# 기기: 지정값이 붙어 있지 않으면 자동 탐색 (무선 디버깅 포트는 재부팅마다 바뀐다)
if [ -z "$DEV" ] || ! "$ADB" devices | grep -q "^$DEV"; then
  [ -n "$DEV" ] && "$ADB" connect "$DEV" >/dev/null 2>&1 || true
  if [ -z "$DEV" ] || ! "$ADB" devices | grep -q "^$DEV"; then
    DEV=$(resolve_device) || exit 1
  fi
fi

a() { "$ADB" -s "$DEV" "$@"; }
dump() { a shell uiautomator dump /sdcard/_stt.xml >/dev/null 2>&1; a shell "cat /sdcard/_stt.xml" 2>/dev/null; }

# uiautomator XML 에서 라벨로 탭 좌표를 찾는다 (좌표 하드코딩을 피한다)
find_tap() {
  python3 -c "
import sys,re,html
x=sys.stdin.read(); want=sys.argv[1]
exact = len(sys.argv)>2 and sys.argv[2]=='exact'
minx  = int(sys.argv[3]) if len(sys.argv)>3 else 0
for m in re.finditer(r'<node[^>]*>', x):
    n=m.group(0)
    t=re.search(r'text=\"([^\"]*)\"',n); d=re.search(r'content-desc=\"([^\"]*)\"',n)
    b=re.search(r'bounds=\"(\[\d+,\d+\]\[\d+,\d+\])\"',n)
    lab=html.unescape((t.group(1) if t else '') or (d.group(1) if d else ''))
    if not b: continue
    hit = (lab==want) if exact else (want in lab)
    if hit:
        c=[int(v) for v in re.findall(r'\d+', b.group(1))]
        if c[0] < minx: continue
        print((c[0]+c[2])//2, (c[1]+c[3])//2); break
" "$@"
}

# resource-id 로 찾는다 — 「텍스트 변환」처럼 같은 라벨이 화면에 둘 이상 있을 때 필요하다
find_id() {
  python3 -c "
import sys,re
x=sys.stdin.read(); want=sys.argv[1]
for m in re.finditer(r'<node[^>]*>', x):
    n=m.group(0)
    r=re.search(r'resource-id=\"([^\"]*)\"',n)
    b=re.search(r'bounds=\"(\[\d+,\d+\]\[\d+,\d+\])\"',n)
    if not (r and b): continue
    if r.group(1).split('/')[-1]==want:
        c=[int(v) for v in re.findall(r'\d+', b.group(1))]
        print((c[0]+c[2])//2, (c[1]+c[3])//2); break
" "$@"
}

# 폰에 올릴 이름은 짧고 고유하게 — 목록 UI 가 긴 이름을 잘라버려서 매칭이 깨진다
# (실측: 31자 이름이 말줄임 처리돼 못 찾음, 9자는 성공). 원본 이름은 결과 파일에만 쓴다.
BASE=$(basename "$SRC")
TAG="stt$(date +%H%M%S)"
EXT="${BASE##*.}"; [ "$EXT" = "$BASE" ] && EXT="m4a"

echo "▶ 1/6 폰으로 전송: $TAG.$EXT"
a push "$SRC" "$REC_DIR/$TAG.$EXT" >/dev/null
a shell "touch '$REC_DIR/$TAG.$EXT'" 2>/dev/null || true
a shell "am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d 'file://$REC_DIR/$TAG.$EXT'" >/dev/null 2>&1
sleep 2

echo "▶ 2/6 앱 열기"
a shell am force-stop "$PKG"
a shell am start -n "$PKG/.main.VNMainActivity" >/dev/null 2>&1
sleep 3
# 사이드바 「음성 녹음」 탭 — 외부에서 넣은 파일은 여기에 들어간다
# shellcheck disable=SC2086
a shell input tap $SIDEBAR_TAP
sleep 2

echo "▶ 3/6 검색으로 찾아 열기"
# 목록은 날짜순이라 옛 파일은 화면 밖에 있고, uiautomator 는 보이는 노드만 덤프한다.
# 그래서 스크롤 대신 검색을 쓴다 (태그가 영문이라 input text 로 칠 수 있다).
SC=$(dump | find_tap "검색")
[ -z "$SC" ] && { echo "❌ 검색 버튼 없음"; exit 2; }
a shell input tap $SC
sleep 2
a shell input text "$TAG"
sleep 3
COORD=$(dump | find_tap "$TAG")
[ -z "$COORD" ] && { echo "❌ 검색 결과 없음 ($TAG)"; exit 2; }
a shell input tap $COORD
sleep 3

echo "▶ 4/6 텍스트 변환 실행"
C1=$(dump | find_tap "텍스트 변환 어시스트")
[ -z "$C1" ] && { echo "❌ 변환 버튼 없음"; exit 3; }
a shell input tap $C1
sleep 2
C2=$(dump | find_tap "텍스트 변환" exact)
[ -z "$C2" ] && { echo "❌ 변환 메뉴 없음"; exit 3; }
a shell input tap $C2
sleep 3

# 「언어 선택」 다이얼로그가 한 번 더 뜰 수 있다. 확인 버튼 라벨이 앞 메뉴와 똑같은
# 「텍스트 변환」이라 text 로 찾으면 헷갈린다 → resource-id 로 집는다.
# 안 뜨는 경우도 있으므로 있으면 처리하고 없으면 지나간다.
DLG=$(dump)
if printf '%s' "$DLG" | grep -q 'select_language_trans_text'; then
  echo "   언어 선택 다이얼로그 → ${STT_LANG:-한국어}"
  CL=$(printf '%s' "$DLG" | find_tap "${STT_LANG:-한국어}" exact)
  if [ -n "$CL" ]; then a shell input tap $CL; sleep 1; DLG=$(dump); fi
  C3=$(printf '%s' "$DLG" | find_id select_language_trans_text)
  [ -z "$C3" ] && { echo "❌ 다이얼로그의 변환 버튼을 못 찾음"; exit 3; }
  a shell input tap $C3
fi

echo "▶ 5/6 전사 대기…"
# 전사가 화면에 나타날 때까지 최대 450초 (앱이 결과 .txt 를 자동 생성하지는 않는다 — 공유로 꺼내야 한다)
READY=0
for i in $(seq 1 90); do
  sleep 5
  if dump | grep -q 'stt_content'; then READY=1; break; fi
done
[ "$READY" -eq 0 ] && { echo "❌ 전사 타임아웃"; exit 4; }
sleep 3   # 마지막 구간까지 확정되도록 여유

if [ "$FETCH" = "none" ]; then
  echo "✅ 전사 완료 — 폰의 음성녹음 앱에 결과가 있습니다."
  echo "   (자동 회수를 쓰려면 STT_INBOX 와 공유 대상을 설정하세요. README 「전사문 회수」 참고)"
  echo "   폰 쪽 파일: $REC_DIR/$TAG.$EXT (회수 없이 끝내면 원본을 지우지 않습니다)"
  exit 0
fi

echo "▶ 6/6 공유로 전문 회수 → $SHARE_TARGET"
BEFORE=$(ls "$INBOX" 2>/dev/null | wc -l | tr -d ' ')
# 오른쪽(상세) 패널의 옵션 메뉴 — 왼쪽 목록에도 같은 이름이 있어 x 하한을 준다
C=$(dump | find_tap "옵션 더보기" any "$DETAIL_MIN_X")
[ -z "$C" ] && { echo "❌ 상세 옵션 메뉴 없음"; exit 5; }
a shell input tap $C; sleep 2
C=$(dump | find_tap "공유" exact)
[ -z "$C" ] && { echo "❌ 공유 항목 없음"; exit 5; }
a shell input tap $C; sleep 3
C=$(dump | find_tap "텍스트 파일" exact)
[ -z "$C" ] && { echo "❌ 형식 선택 없음"; exit 5; }
a shell input tap $C; sleep 4
C=$(dump | find_tap "$SHARE_TARGET")
[ -z "$C" ] && { echo "❌ 공유 시트에 「$SHARE_TARGET」 없음"; exit 5; }
a shell input tap $C

# 수신 앱이 인박스에 떨어뜨릴 때까지 (최대 60초)
OUT=""
for i in $(seq 1 30); do
  sleep 2
  NOW=$(ls "$INBOX" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$NOW" -gt "$BEFORE" ]; then
    NEW=$(ls -t "$INBOX" | head -1)
    # 결과는 UTF-16(BOM) 으로 온다
    OUT=$(python3 -c "
import sys
raw=open(sys.argv[1],'rb').read()
for enc in ('utf-16','utf-8','cp949'):
    try:
        t=raw.decode(enc)
        if t.strip(): print(t); break
    except Exception: pass
" "$INBOX/$NEW")
    [ -n "$OUT" ] && { rm -f "$INBOX/$NEW"; break; }
  fi
done
[ -z "$OUT" ] && { echo "❌ 맥에서 전사본 수신 실패"; exit 6; }

if [ -n "$OUTDIR" ]; then
  mkdir -p "$OUTDIR"
  DEST="$OUTDIR/$(basename "${SRC%.*}").txt"
else
  DEST="${SRC%.*}.txt"
fi
printf '%s\n' "$OUT" > "$DEST"
echo "✅ 저장: $DEST  ($(printf '%s' "$OUT" | wc -m | tr -d ' ')자)"
echo "─────"
printf '%s\n' "$OUT" | head -6

if [ "$KEEP" -eq 0 ]; then
  a shell "rm -f '$REC_DIR/$TAG.$EXT'" 2>/dev/null || true
  echo "(폰에서 원본 삭제 — 남기려면 --keep)"
fi
