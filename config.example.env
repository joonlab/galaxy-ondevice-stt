# galaxy-ondevice-stt 설정 예시
# 복사: mkdir -p ~/.config/galaxy-ondevice-stt && cp config.example.env ~/.config/galaxy-ondevice-stt/config.env
# 형식: KEY=VALUE. ~ 와 $HOME 은 펼칩니다. 같은 이름의 환경변수가 있으면 그쪽이 우선합니다.

# ── 기기 ─────────────────────────────────────────────
# adb 기기 ID. 비우면 mDNS → 기본 게이트웨이(핫스팟) → Tailscale 순으로 자동 탐색합니다.
# 예: <폰 IP>:5555  (자기 폰의 IP:포트, 무선 디버깅 화면에 나옵니다)
PHONE_ADB=
# adb 경로. 비우면 PATH → ~/Library/Android/sdk/platform-tools/adb
ADB=

# ── 전사문 회수 (선택) ───────────────────────────────
# 삼성 앱은 전사 결과를 파일로 내보내지 않아서, 공유 시트로 맥에 보내야 전문을 받을 수 있습니다.
# 공유된 .txt 가 맥의 어느 폴더에 떨어지는지 적으세요. (저는 직접 만든 ClipBridge 수신 폴더를 씁니다)
# 비워 두면 전사만 실행하고 결과는 폰 앱에 남겨 둡니다 (STT_FETCH=none 과 같음).
STT_INBOX=
# 공유 시트에서 누를 대상의 라벨 (화면에 보이는 글자 그대로)
STT_SHARE_TARGET=맥으로 보내기
# clipbridge | none  (비우면 STT_INBOX 유무로 결정)
STT_FETCH=

# ── 삼성 음성녹음 앱 UI ──────────────────────────────
# 「언어 선택」 다이얼로그에서 고를 언어 라벨
STT_LANG=한국어
# 사이드바 「음성 녹음」 탭 좌표 (폴드8 펼친 화면 기준). 기기가 다르면 uiautomator dump 로 확인
STT_SIDEBAR_TAP=120 508
# 2패널 화면에서 오른쪽(상세) 패널로 볼 x 하한 (px)
STT_DETAIL_MIN_X=1150

# ── stt-queue (자동 전사 큐) ─────────────────────────
# 폰 녹음이 동기화되는 맥 폴더들, 콜론(:)으로 구분 (예: Syncthing 으로 받는 폴더)
STT_REC_DIRS=~/Music/phone-recordings
# 전사 결과를 쓸 폴더 (Syncthing Receive Only 폴더는 피하세요)
STT_OUT_DIR=~/Documents/phone-stt-transcripts
# 큐 상태 파일 — 녹음 파일명이 들어가므로 저장소 밖에 둡니다
STT_STATE=~/.local/state/galaxy-ondevice-stt/queue.json
